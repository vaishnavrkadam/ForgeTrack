# ==============================================================================
# ForgeTrack Environment Configuration
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3001

# Database Configuration (PostgreSQL)
# Note: Zero Docker setup is required for local dev if Postgres is not running (an embedded in-memory PG will boot)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=forgetrack
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# Security & Session Secrets
SESSION_SECRET=change-to-a-secure-random-32-character-secret-in-production

# AI & LLM Service Integration (Optional)
GEMINI_API_KEY=

# CORS Origins (Comma separated URLs for production allowed frontend domains)
# Example: https://forgetrack.yourdomain.com,https://forgetrack-web.vercel.app
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Frontend Next.js API Base URL (Used by apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# OAuth Integrations (Optional / fallback to dev-login when not configured)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Email & Notification Delivery (Optional - Resend, SendGrid, or console fallback)
EMAIL_FROM=ForgeTrack <noreply@forgetrack.dev>
EMAIL_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
